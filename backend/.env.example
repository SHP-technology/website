# Django Backend Environment Configuration

# Security & Debug
SECRET_KEY=your_secret_key_here
DEBUG=False

# Host, CORS & CSRF Settings
ALLOWED_HOSTS=127.0.0.1,localhost,shptech.onrender.com,api.shptechnology.online,*.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,https://shptechnology.online,https://www.shptechnology.online
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,https://shptechnology.online,https://www.shptechnology.online,https://shptech.onrender.com

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password_in_prod

# Server Port (Default: 8000)
PORT=8000

# Resend Email Configuration
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=SHP Technology <hello@shptechnology.online>
COMPANY_EMAIL=hello@shptechnology.online
